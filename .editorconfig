root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120
ij_php_align_key_value_pairs = true

[*.css]
indent_size = 2

[*.js]
indent_size = 2

[*.twig]
indent_size = 2
max_line_length = 360
trim_trailing_whitespace = false